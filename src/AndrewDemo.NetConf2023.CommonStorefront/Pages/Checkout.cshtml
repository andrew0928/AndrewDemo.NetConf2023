@page "/checkout"
@model AndrewDemo.NetConf2023.CommonStorefront.Pages.CheckoutModel
@{
    ViewData["Title"] = "結帳";
}
<section>
    <h1 class="page-heading">結帳</h1>
    <p class="hint-text">確認商品與付款方式後送出訂單。此示範商店尚未串接真實金流。</p>
</section>

@if (Model.ErrorSummary.Errors.Count > 0)
{
    <partial name="_ErrorSummary" model="Model.ErrorSummary" />
}

@if (Model.Operation != null)
{
    <partial name="_OperationSummary" model="Model.Operation" />
}

@if (!Model.Lines.Any())
{
    <section class="panel">
        <p>目前沒有可結帳的商品。</p>
        <p><a class="button button--secondary" href="/products">返回商品列表</a></p>
    </section>
}
else
{
    <section class="panel">
        <h2>訂單摘要</h2>
        <ul class="cart-lines">
            @foreach (var line in Model.Lines)
            {
                <li>
                    <strong>@line.ProductName</strong>
                    <p>數量：@line.Quantity</p>
                    <p>小計：NT$ @line.LineAmount</p>
                </li>
            }
        </ul>
        <partial name="_PriceSummary" model="Model.PriceSummary" />
    </section>

    <section class="panel">
        <h2>確認送單</h2>
        <p>必要檢查通過後才會建立訂單。測試交易同樣需要通過商品與庫存檢查。</p>
        <form method="post">
            <fieldset aria-describedby="payment-help payment-error">
                <legend>付款方式</legend>
                <p id="payment-help" class="hint-text">測試會員或使用測試付款，都會建立測試交易；實際用途以結帳結果為準。</p>
                <p><input asp-for="PaymentMode" type="radio" id="payment-normal" value="normal" />
                    <label for="payment-normal">一般示範付款</label></p>
                <p><input asp-for="PaymentMode" type="radio" id="payment-test" value="test" />
                    <label for="payment-test">測試付款（不產生真實商業效果）</label></p>
                <span asp-validation-for="PaymentMode" id="payment-error"></span>
            </fieldset>
            <div class="page-actions">
                <button class="button button--primary" type="submit">送出訂單</button>
                <a class="button button--secondary" href="/cart">返回購物車</a>
            </div>
        </form>
    </section>
}
